# Copiar este archivo como .env y reemplazar los valores.

# Contraseña del usuario 'sa' del SQL Server local.
# Requisitos de SQL Server: mínimo 8 caracteres, con mayúsculas, minúsculas, números y símbolos.
MSSQL_SA_PASSWORD=CambiaEstaClave_123!

# Nombre de la base de datos de origen
DB_NAME=RetailMax

# Puerto local expuesto
SQL_PORT=1433
